{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prime-shell.local/schemas/errors.schema.json",
  "title": "Prime Shell Safe Error Envelope",
  "$defs": {
    "safeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "CONFLICT",
            "PERMISSION_DENIED",
            "BACKEND_UNAVAILABLE",
            "BACKEND_CRASHED",
            "BACKEND_PROTOCOL_MISMATCH",
            "PROTOCOL_ERROR",
            "RESOURCE_EXHAUSTED",
            "TIMEOUT",
            "CANCELLED",
            "INTERRUPTED",
            "IO_ERROR",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "kind", "requestId", "traceId", "error"],
  "properties": {
    "protocol": { "const": "generic-app" },
    "kind": { "const": "error" },
    "requestId": { "type": ["string", "null"], "maxLength": 128 },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "error": { "$ref": "#/$defs/safeError" }
  }
}
